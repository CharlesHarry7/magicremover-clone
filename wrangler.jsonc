{
	"$schema": "node_modules/wrangler/config-schema.json",
	// OpenNext Cloudflare Worker + Workers Static Assets (ASSETS).
	// REQUIRED: always publish Worker (main) AND assets.directory together via
	//   npm run deploy   # or npm run upload (non-prod version)
	//   = opennextjs-cloudflare build && check:assets && opennextjs-cloudflare …
	// DO NOT use Cloudflare Pages git / `next build` / assets-only uploads.
	// Broken edge looks like: empty `/` 404 (ASSETS _headers, no SSR Worker) +
	// mixed `/_next/static/*` 404 (stale ASSETS) → unstyled bare HTML, no hydrate.
	// If magicremover-clone.pages.dev is still bound to a legacy Pages project,
	// disconnect/delete that Pages project in the dashboard, then redeploy here.
	// Prefer workers.dev for QA until pages.dev is unbound + redeployed.
	"main": ".open-next/worker.js",
	"name": "magicremover-clone",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Serve workers.dev in addition to any pages.dev alias bound in the dashboard.
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		// Built by `opennextjs-cloudflare build` — includes /_next/static/** and public/**
		"directory": ".open-next/assets",
		"binding": "ASSETS"
		// run_worker_first defaults to false: platform serves matching ASSETS
		// (CSS/JS/media/cases) before invoking the Worker. Do not remove this binding.
	},
	"services": [
		{
			// Required by OpenNext revalidation/queue wiring; must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "magicremover-clone"
		}
	]
}
