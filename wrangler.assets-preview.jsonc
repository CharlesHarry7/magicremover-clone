{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Assets-only preview Worker (NO OpenNext SSR handler).
	// Use when temporary/free accounts cannot fit the ~5MiB OpenNext Worker:
	//   npx wrangler deploy --temporary -c wrangler.assets-preview.jsonc
	// Proves `/_next/static/**` and `/cases/**` return 200 from the ASSETS bundle.
	// Full app preview still requires: npm run upload / npm run deploy (real account).
	"name": "magicremover-assets-preview",
	"compatibility_date": "2026-08-12",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": ".open-next/assets"
	}
}
