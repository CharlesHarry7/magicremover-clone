# Local Next.js (`npm run dev` / `npm run build`)
# Copy to `.env.local` — Next does not read `.dev.vars`.
REPLICATE_API_TOKEN=

# Optional: absolute site URL for Open Graph / Twitter / canonical (production).
# Deployed builds fall back to the workers.dev origin — never localhost.
# NEXT_PUBLIC_SITE_URL=https://magicremover-clone.guochao950518.workers.dev
