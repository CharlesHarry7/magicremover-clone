# Local Next.js (`npm run dev` / `npm run build`)
# Copy to `.env.local` — Next does not read `.dev.vars`.
REPLICATE_API_TOKEN=

# Optional: absolute site URL for Open Graph / Twitter / canonical (production).
# Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL=https://your-worker.example.com
